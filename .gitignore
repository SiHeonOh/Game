# Unreal Engine
# Patterns have no leading slash, so they also match when the Unreal
# project lives in a subfolder (for example "Game Files/WarGame/").

# Generated by the engine and editor; rebuilt automatically
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# Built lighting data; rebuild it in the editor
*_BuiltData.uasset

# Packaged builds: package the game into a folder named "Packaged"
Packaged/

# Blender backup and temporary save files
*.blend1
*.blend@

# IDE files (regenerate with "Generate Visual Studio project files")
.vs/
.idea/
.vscode/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace

# Operating system clutter
Thumbs.db
Desktop.ini
.DS_Store
